{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Requester host tests",
      "description": "Build pure requester outcome tests without the Switch toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REQUESTER_BUILD_HOST_TESTS": "ON"
      }
    },
    {
      "name": "switch",
      "displayName": "Nintendo Switch",
      "description": "Build the requester NRO with devkitPro and Borealis.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "targets": [
        "requester_bsd_outcome_tests",
        "requester_udp_workload_metrics_tests"
      ]
    },
    {
      "name": "requester",
      "displayName": "Requester NRO",
      "configurePreset": "switch",
      "targets": [
        "requester_nro"
      ]
    }
  ]
}
