{
  "source_roots": [
    "src",
    "test"
  ],
  "exclude": [],
  "include_dirs": [
    "src",
    "../common/include",
    "libs/borealis/library/include",
    "libs/borealis/library/lib",
    "libs/borealis/library/lib/extern/switch-libpulsar/include",
    "libs/wireguard-nx/common/include"
  ],
  "suppressions": [
    "unknownMacro:*src/manual_bsd_lifecycle.cpp",
    "syntaxError:*libs/wireguard-nx/common/include/wgnx/client.hpp"
  ],
  "tidy_source_roots": [
    "src"
  ],
  "tidy_exclude": [],
  "tidy_include_dirs": [
    "src",
    "../common/include",
    "libs/borealis/library/include",
    "libs/borealis/library/include/borealis/extern",
    "libs/borealis/library/include/borealis/extern/nanovg",
    "libs/borealis/library/lib",
    "libs/borealis/library/lib/extern/switch-libpulsar/include",
    "${WGNX_COMMON}/include"
  ],
  "tidy_arguments": [
    "--target=aarch64-none-elf",
    "--sysroot=${DEVKITPRO}/devkitA64/aarch64-none-elf",
    "-std=gnu++23",
    "-D__GLFW__",
    "-DTARGET=\"requester\"",
    "-DAPP_TITLE=\"NX Reversing Requester\"",
    "-DAPP_AUTHOR=\"chrisbraucker\"",
    "-DAPP_PROJECT_URL=\"https://github.com/chrisbraucker/nx-reverse\"",
    "-DNXRV_VERSION=\"0.1.0\"",
    "-DNXRV_BUILD_ID=\"tidy\"",
    "-DREQUESTER_PACKET_DIAGNOSTICS=0",
    "-isystem",
    "${DEVKITPRO}/devkitA64/aarch64-none-elf/include/c++/15.2.0",
    "-isystem",
    "${DEVKITPRO}/devkitA64/aarch64-none-elf/include/c++/15.2.0/aarch64-none-elf",
    "-I${DEVKITPRO}/portlibs/switch/include",
    "-I${DEVKITPRO}/libnx/include"
  ]
}
