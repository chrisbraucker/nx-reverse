{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wgnx.dev/nx-reversing/service-contract.schema.json",
  "title": "net-probe service contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "title", "firmware", "targets", "access_modes", "objects", "workflows", "constraints", "provenance"],
  "properties": {
    "$schema": {"const": "../schema/service-contract.schema.json"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "firmware": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/firmware"}},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "access_modes": {"type": "array", "minItems": 1, "items": {"enum": ["passive_mitm", "direct_probe"]}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
  },
  "$defs": {
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "confidence"],
      "properties": {"version": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}, "scope": {"type": "string"}}
    },
    "confidence": {"enum": ["confirmed", "observed", "provisional"]},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "name", "operations"],
      "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "name": {"type": "string"}, "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "confidence"],
      "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string"}, "request": {"$ref": "#/$defs/io"}, "response": {"$ref": "#/$defs/io"}, "confidence": {"$ref": "#/$defs/confidence"}, "notes": {"type": "string"}}
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}, "buffers": {"type": "array", "items": {"$ref": "#/$defs/field"}}, "handles": {"type": "array", "items": {"$ref": "#/$defs/field"}}}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {"name": {"type": "string"}, "type": {"enum": ["u8", "u16", "u32", "u64", "s8", "s16", "s32", "s64", "bool", "ipv4", "uuid", "sockaddr", "handle", "handle[]", "buffer", "opaque"]}, "description": {"type": "string"}, "required": {"type": "boolean"}}
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "purpose", "confidence", "sessions", "steps"],
      "properties": {"id": {"type": "string"}, "kind": {"enum": ["passive", "observed", "diagnostic"]}, "purpose": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"}, "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "notes": {"type": "string"}}
    },
    "session": {"type": "object", "additionalProperties": false, "required": ["role", "count"], "properties": {"role": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "description": {"type": "string"}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["id", "action"], "properties": {"id": {"type": "string"}, "session": {"type": "string"}, "action": {"type": "string"}, "operation": {"type": "string"}, "arguments": {"type": "array", "items": {"type": "string"}}, "bind": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"enum": ["implemented_decoder", "passive_trace", "controlled_experiment", "static_analysis"]}, "reference": {"type": "string"}}}
  }
}
